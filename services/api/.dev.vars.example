# Copy to .dev.vars for local development. Never commit real credentials.
AI_API_KEY=
OPENCODE_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER=fixture
AI_MODEL=fixture-v1
IMAGE_SAFETY_MODEL=gpt-5.6-luna
PUBLIC_PLAYER_ORIGIN=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8787,http://localhost:3000
ADMIN_TOKEN=replace-with-a-random-value-of-at-least-32-characters
ADMIN_ENCRYPTION_KEY=replace-with-a-different-random-value-of-at-least-32-characters
DEVICE_TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Inference transport: direct (default) or tkslopper.
INFERENCE_TRANSPORT=direct
TKSLOPPER_CONTROL_PLANE_URL=
TKSLOPPER_GATEWAY_URL=
TKSLOPPER_SERVICE_CREDENTIAL=
TKSLOPPER_ARTIFACT_ALIAS=
TKSLOPPER_REVIEW_ALIAS=
TKSLOPPER_IMAGE_ALIAS=
TKSLOPPER_ARTIFACT_EFFORT=high
TKSLOPPER_REVIEW_EFFORT=low
TKSLOPPER_IMAGE_EFFORT=omit
TKSLOPPER_ARTIFACT_ENDPOINT=responses
TKSLOPPER_MAX_REQUEST_BYTES=1048576
